# erxes gateway (Apollo Router), no trailing slash. Used by the browser and by
# server-side rendering. ERXES_API_URL is the canonical name; the build inlines
# it into the client bundle, so change it before `pnpm build`.
ERXES_API_URL=http://localhost:4000

# ClientPortal app token (Settings -> Client portal -> your portal -> App token).
# Sent as the `x-app-token` header on every GraphQL request.
NEXT_PUBLIC_ERXES_CP_TOKEN=

# ClientPortal _id, passed to clientPortalUserRegister when an invite is accepted.
NEXT_PUBLIC_CLIENT_PORTAL_ID=
